FROM ${BASE_IMAGE} AS connector-build
ARG TARGETARCH
ARG BUILD_JOBS=16
RUN test "${TARGETARCH}" = amd64 && \
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential git pkg-config ninja-build patchelf \
        cuda-driver-dev-13-5 cuda-cudart-dev-13-5 \
        libibverbs-dev libnuma-dev libgoogle-glog-dev libgflags-dev \
        libjsoncpp-dev libyaml-cpp-dev libssl-dev libcurl4-openssl-dev \
        libboost-dev liburing-dev libjemalloc-dev libmsgpack-dev \
        libasio-dev libzstd-dev libxxhash-dev && \
    rm -rf /var/lib/apt/lists/* && \
    uv venv --system-site-packages /opt/.venv && \
    uv pip install --python /opt/.venv/bin/python \
        build meson meson-python pybind11 patchelf pyyaml types-PyYAML \
        pytest setuptools wheel tomlkit scikit-build-core auditwheel cmake ninja
ENV PATH=/opt/.venv/bin:${PATH} \
    CMAKE_BUILD_PARALLEL_LEVEL=${BUILD_JOBS}

FROM connector-build AS mooncake-build
ARG MOONCAKE_COMMIT
WORKDIR /src/mooncake
RUN git init && git remote add origin https://github.com/kvcache-ai/Mooncake.git && \
    git fetch --depth=1 origin "${MOONCAKE_COMMIT}" && git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${MOONCAKE_COMMIT}"
RUN sed -i \
        -e 's/name = "mooncake-transfer-engine"/name = "mooncake-transfer-engine-cuda13"/' \
        -e 's/version = "0.3.12.post1"/version = "0.3.14+efa.ed1b346b"/' pyproject.toml && \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH} \
    uv build --python /opt/.venv/bin/python --wheel --no-build-isolation \
        --out-dir /tmp/mooncake-wheel \
        -Ccmake.define.USE_CUDA=ON -Ccmake.define.USE_EFA=ON \
        -Ccmake.define.LIBFABRIC_INCLUDE_DIR=/opt/amazon/efa/include \
        -Ccmake.define.USE_HTTP=ON -Ccmake.define.USE_INTRA_NVLINK=ON \
        -Ccmake.define.WITH_TE=ON -Ccmake.define.WITH_STORE=ON \
        -Ccmake.define.WITH_CONDUCTOR=OFF -Ccmake.define.WITH_EP=OFF \
        -Ccmake.define.WITH_PG=OFF -Ccmake.define.WITH_STORE_RUST=OFF \
        -Ccmake.define.WITH_STORE_RS=OFF -Ccmake.define.WITH_STORE_GO=OFF \
        -Ccmake.define.BUILD_UNIT_TESTS=OFF -Ccmake.define.BUILD_EXAMPLES=OFF && \
    auditwheel repair --wheel-dir /wheels \
        --exclude libcuda.so.1 --exclude libcudart.so.13 \
        --exclude libibverbs.so.1 --exclude libmlx5.so.1 --exclude libnuma.so.1 \
        /tmp/mooncake-wheel/*.whl

FROM connector-build AS nixl-build
ARG NIXL_COMMIT
WORKDIR /src/nixl
RUN git init && git remote add origin https://github.com/ai-dynamo/nixl.git && \
    git fetch --depth=1 origin "${NIXL_COMMIT}" && git checkout --detach FETCH_HEAD && \
    test "$(git rev-parse HEAD)" = "${NIXL_COMMIT}"
COPY docker/m3p1-b300/nixl-1.5.2-reconnect.patch /tmp/nixl-reconnect.patch
RUN git apply --check /tmp/nixl-reconnect.patch && git apply /tmp/nixl-reconnect.patch && \
    /opt/.venv/bin/python contrib/tomlutil.py --wheel-name nixl-cu13 pyproject.toml && \
    sed -i 's/version = "1.5.2"/version = "1.5.2+reconnect"/' pyproject.toml && \
    sed -i "s/version: '1.5.2'/version: '1.5.2+reconnect'/" meson.build && \
    uv build --python /opt/.venv/bin/python --wheel --no-build-isolation \
        --out-dir /wheels \
        -Csetup-args=-Dlibfabric_path=/opt/amazon/efa \
        -Csetup-args=-Denable_plugins=LIBFABRIC \
        -Csetup-args=-Dbuild_tests=false -Csetup-args=-Dbuild_examples=false \
        -Csetup-args=-Dbuild_nixl_ep=false -Csetup-args=-Dwith_trace=false \
        -Csetup-args=-Dnixl_cuda_arch_list=103 \
        -Ccompile-args=-j${BUILD_JOBS}

FROM ${BASE_IMAGE}
ARG TARGETARCH
ARG BRANCH_COMMIT
ARG MOONCAKE_COMMIT
ARG NIXL_COMMIT
RUN test "${TARGETARCH}" = amd64 && test -n "${BRANCH_COMMIT}" && \
    apt-get update && apt-get install -y --no-install-recommends \
        binutils libibverbs1 ibverbs-providers libnuma1 && rm -rf /var/lib/apt/lists/*
RUN --mount=type=bind,from=mooncake-build,source=/wheels,target=/tmp/mooncake-wheels \
    --mount=type=bind,from=nixl-build,source=/wheels,target=/tmp/nixl-wheels \
    uv pip uninstall --system mooncake-transfer-engine mooncake-transfer-engine-cuda13 \
        nixl-cu12 nixl-cu13 nvidia-cutlass-dsl-libs-cu12 && \
    uv pip install --system --no-deps /tmp/mooncake-wheels/*.whl /tmp/nixl-wheels/*.whl

RUN --mount=type=bind,from=kernel-sources,source=/vllm,target=/tmp/kernels/vllm \
    --mount=type=bind,source=vllm,target=/tmp/src/vllm \
    --mount=type=bind,source=docker/m3p1-gb300,target=/tmp/lists \
    set -e; \
    uv venv --system-site-packages /tmp/check-venv; \
    sp=$(/tmp/check-venv/bin/python -c 'import importlib.metadata as m; print(m.distribution("vllm").locate_file(""))'); \
    cd /tmp/src; sha256sum -c --quiet /tmp/lists/vllm-files.sha256; \
    for source in /tmp/src /tmp/kernels; do \
        if [ "$source" = /tmp/src ]; then list=vllm-files; else list=kernel-sources; fi; \
        while read -r hash file; do \
            if [ -x "$source/$file" ]; then mode=0755; else mode=0644; fi; \
            install -D -m "$mode" "$source/$file" "$sp/$file"; \
            case "$file" in *.py) \
                cache="$(dirname "$sp/$file")/__pycache__"; \
                if [ -d "$cache" ]; then \
                    find "$cache" -maxdepth 1 -name "$(basename "$file" .py).*pyc" -delete; \
                fi ;; esac; \
        done < "/tmp/lists/$list.sha256"; \
        (cd "$sp" && sha256sum -c --quiet "/tmp/lists/$list.sha256"); \
    done; \
    rm -rf /tmp/check-venv

RUN --mount=type=bind,source=docker/m3p1-b300/check-image.py,target=/tmp/check-image.py \
    --mount=type=bind,from=connector-build,source=/usr/local/cuda/lib64/stubs/libcuda.so,target=/tmp/libcuda.so.1 \
    set -e; \
    nvcc --version | grep -q 'release 13\.5,'; \
    /opt/amazon/efa/bin/fi_info -l | grep -q '^efa:'; \
    plugin=$(find /usr/local/lib -name libplugin_LIBFABRIC.so -print -quit); \
    test -n "$plugin"; \
    ldd "$plugin" | grep -q 'libfabric\.so\.1 => /opt/amazon/efa/lib/'; \
    ldconfig -p | grep -q '/opt/amazon/ofi-nccl/lib/libnccl-net-ofi\.so'; \
    ldconfig -p | grep -q '/opt/amazon/ofi-nccl/lib/libnccl-tuner-ofi\.so'; \
    uv venv --system-site-packages /tmp/check-venv; \
    LD_LIBRARY_PATH=/tmp:${LD_LIBRARY_PATH} /tmp/check-venv/bin/python /tmp/check-image.py; \
    rm -rf /tmp/check-venv

LABEL org.opencontainers.image.source="https://github.com/ivanium/vllm" \
      org.opencontainers.image.revision="${BRANCH_COMMIT}" \
      org.opencontainers.image.base.digest="sha256:f2036e7a2b69217d9fbf048caf4b994fbd996d7821939938e33a4f4a2ce009e3" \
      ai.vllm.mooncake.revision="${MOONCAKE_COMMIT}" \
      ai.vllm.nixl.revision="${NIXL_COMMIT}" \
      ai.vllm.nixl.patch="94266532814b823b543fa341c8dffcb486e59b41 (backport)"
