# syntax=docker/dockerfile:1.10
# check=skip=FromPlatformFlagConstDisallowed
#
# MiniMax-M3.1-Flash on GB300 (linux/arm64 only): the vLLM CUDA 13.5 nightly this branch is based
# on (vllm-project/vllm 153dc046) with this branch's vllm/ files, the DeepGEMM and MSA (fmha_sm100)
# JIT kernel sources it needs, and Mooncake 0.3.13.post1+hbm. Nothing is compiled: the build copies
# files, and checks each one against the sha256 lists in docker/m3p1-gb300/ (see its README.md).
#
# From the root of a clean checkout of this branch:
#   docker buildx build --platform linux/arm64 -f docker/Dockerfile.m3p1-gb300 \
#     --build-arg BRANCH_COMMIT=$(git rev-parse HEAD) \
#     -t vllm-m3p1-gb300:$(git rev-parse --short=10 HEAD) --load .

# vllm/vllm-openai:cu135-nightly-153dc046... (index sha256:712ef89a...): its linux/arm64 image.
ARG BASE_IMAGE=docker.io/vllm/vllm-openai:cu135-nightly-153dc046462c4724a9a4eb393cadd60169ed943c@sha256:18dfff3057619a1353d939c0030e9371b71fdf7519951bfe67eb9965c6b513b9
# The last layer of vllm/vllm-openai:cu134-arm64-1107-mdev
# (sha256:1b4a9b46c217ae3665b5e793341892d555b9bd5ca81230eed26e1b94a42b5801): Mooncake
# 0.3.13.post1+hbm, whose store binding has the mount_external_segment that the Mooncake store
# connector's hbm_pool uses. Its source is not public. The 13 MB layer is fetched by digest rather
# than pulling the whole image.
ARG MOONCAKE_LAYER=sha256:65bd369b53169f43dd3e40c9e8bc196e154a353a9a65053ab66c5469b5ea4761
# DeepGEMM: this branch's pin in cmake/external_projects/deepgemm.cmake (the base vendors 0f7698fe,
# one commit earlier). MSA: the head of vllm-project/MSA#49 (MXFP8 output for the Q8KV4 kernels),
# over the base's fmha_sm100 at the pin in cmake/external_projects/fmha_sm100.cmake.
ARG DEEPGEMM_COMMIT=196f33873c658bde81a669bb645bac4823f8cd61
ARG MSA_COMMIT=56bf386fb528a79acc4e51954a6ce72b1eaacd95

# The JIT kernel sources the image's DeepGEMM and fmha_sm100 compile at run time, at the paths
# they are installed to under vllm/ (kernel-sources.sha256 lists the same files and hashes).
FROM scratch AS kernel-sources
ARG DEEPGEMM_COMMIT
ARG MSA_COMMIT
ADD --checksum=sha256:9ca739659c69d5413790ad18add91104bd20cea30ac2e48ea3f9751ed050a20e https://raw.githubusercontent.com/vllm-project/DeepGEMM/${DEEPGEMM_COMMIT}/deep_gemm/include/deep_gemm/impls/sm100_bf16_mega_moe.cuh /vllm/third_party/deep_gemm/include/deep_gemm/impls/sm100_bf16_mega_moe.cuh
