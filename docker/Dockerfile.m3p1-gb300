ADD --checksum=sha256:5b12b6ade8873c713d0a3d173e58a2971179fef9563d00af60cc04183f7ed4c2 https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/q8kv4_decode_adapter.py /vllm/third_party/fmha_sm100/q8kv4_decode_adapter.py

# Mooncake 0.3.13.post1+hbm out of that layer, checked by digest; whiteouts are skipped.
FROM --platform=linux/arm64 ${BASE_IMAGE} AS mooncake-hbm
ARG MOONCAKE_LAYER
RUN set -eu; \
    repo=vllm/vllm-openai; \
    token=$(curl -fsS "https://auth.docker.io/token?service=registry.docker.io&scope=repository:${repo}:pull" \
        | python3 -I -c 'import json, sys; print(json.load(sys.stdin)["token"])'); \
    curl -fsSL -H "Authorization: Bearer ${token}" -o /tmp/layer.tgz \
        "https://registry-1.docker.io/v2/${repo}/blobs/${MOONCAKE_LAYER}"; \
    echo "${MOONCAKE_LAYER#sha256:}  /tmp/layer.tgz" | sha256sum -c -; \
    mkdir /payload; \
    tar -xzf /tmp/layer.tgz -C /payload --exclude='.wh.*' \
        usr/local/lib/python3.12/dist-packages/mooncake \
        usr/local/lib/python3.12/dist-packages/mooncake_transfer_engine_cuda13-0.3.13.post1+hbm.dist-info \
        usr/lib/aarch64-linux-gnu; \
    rm /tmp/layer.tgz

FROM --platform=linux/arm64 ${BASE_IMAGE}
ARG SP=/usr/local/lib/python3.12/dist-packages
ARG BRANCH_COMMIT=unknown

# 1. Mooncake 0.3.13.post1+hbm replaces the base's PyPI Mooncake (package, dist-info and bundled
#    libraries) and brings the five libraries it links, with their soname links (cp -a keeps them
#    links). The base's mooncake_master console script stays; it runs mooncake.cli.
RUN --mount=type=bind,from=mooncake-hbm,source=/payload,target=/tmp/m3p1/mooncake \
    --mount=type=bind,source=docker/m3p1-gb300,target=/tmp/m3p1/lists \
    set -eu; \
    mc=/tmp/m3p1/mooncake; \
    rm -rf "$SP/mooncake" "$SP"/mooncake_transfer_engine_cuda13-*.dist-info "$SP/mooncake_transfer_engine_cuda13.libs"; \
    cp -a "$mc$SP/mooncake" "$mc$SP/mooncake_transfer_engine_cuda13-0.3.13.post1+hbm.dist-info" "$SP/"; \
    cp -a "$mc"/usr/lib/aarch64-linux-gnu/* /usr/lib/aarch64-linux-gnu/; \
    sha256sum -c --quiet /tmp/m3p1/lists/mooncake-hbm.sha256

# 2. The DeepGEMM and MSA JIT kernel sources, readable by every user (ADD leaves a downloaded file
#    at mode 600), and the bytecode of the Python ones removed.
RUN --mount=type=bind,from=kernel-sources,source=/vllm,target=/tmp/m3p1/kernels/vllm \
    --mount=type=bind,source=docker/m3p1-gb300,target=/tmp/m3p1/lists \
    set -eu; \
    while read -r _ f; do \
        install -D -m 0644 "/tmp/m3p1/kernels/$f" "$SP/$f"; \
        case $f in *.py) rm -f "$SP/${f%/*}/__pycache__/$(basename "$f" .py)".cpython-312*.pyc ;; esac; \
    done < /tmp/m3p1/lists/kernel-sources.sha256; \
    cd "$SP" && sha256sum -c --quiet /tmp/m3p1/lists/kernel-sources.sha256

# 3. The vllm/ files this branch changes from 153dc046, from the build context. The checkout must
#    hold exactly the listed contents, or the build stops. Each file gets its git mode (0755 if
#    executable, else 0644), and the bytecode of the Python ones is removed.
RUN --mount=type=bind,source=vllm,target=/tmp/m3p1/src/vllm \
    --mount=type=bind,source=docker/m3p1-gb300,target=/tmp/m3p1/lists \
    set -eu; \
    cd /tmp/m3p1/src && sha256sum -c --quiet /tmp/m3p1/lists/vllm-files.sha256; \
    while read -r _ f; do \
        if [ -x "$f" ]; then mode=0755; else mode=0644; fi; \
        install -D -m "$mode" "$f" "$SP/$f"; \
        case $f in *.py) rm -f "$SP/${f%/*}/__pycache__/$(basename "$f" .py)".cpython-312*.pyc ;; esac; \
    done < /tmp/m3p1/lists/vllm-files.sha256; \
    cd "$SP" && sha256sum -c --quiet /tmp/m3p1/lists/vllm-files.sha256

# 4. Static checks (no GPU): the CUDA 13.5 toolkit, the store binding with mount_external_segment,
#    and one Mooncake distribution, 0.3.13.post1+hbm. Writes no bytecode.
RUN set -eu; \
    nvcc --version | grep -q 'release 13\.5,'; \
    grep -aq mount_external_segment "$SP/mooncake/_store.cpython-312-aarch64-linux-gnu.so"; \
    python3 -I -B -c 'import importlib.metadata as m; \
d = sorted((x.metadata["Name"].lower(), x.version) for x in m.distributions() if "mooncake" in (x.metadata["Name"] or "").lower()); \
assert d == [("mooncake-transfer-engine-cuda13", "0.3.13.post1+hbm")], d; \
print("; ".join(n + " " + m.version(n) for n in ("vllm", "torch", "flashinfer-python", "mooncake-transfer-engine-cuda13")))'

# The vLLM version string, VLLM_* environment and ai.vllm.* labels stay the base nightly's.
LABEL org.opencontainers.image.source="https://github.com/kyleliang-nv/vllm" \
      org.opencontainers.image.revision="${BRANCH_COMMIT}" \
      org.opencontainers.image.version="m3p1-gb300-${BRANCH_COMMIT}" \
      org.opencontainers.image.base.name="docker.io/vllm/vllm-openai:cu135-nightly-153dc046462c4724a9a4eb393cadd60169ed943c" \
      org.opencontainers.image.base.digest="sha256:18dfff3057619a1353d939c0030e9371b71fdf7519951bfe67eb9965c6b513b9"
