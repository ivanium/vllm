ADD --checksum=sha256:5b58850456c33b2080d3c9e104c20c3c7461b40a93d93d0e44b846a0016d4e6d https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/src/decode_attention_reduction.cu /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/src/decode_attention_reduction.cu
ADD --checksum=sha256:219247912accd2c3f9cce0ea10899535ab6eb200eb90ed12ef9986046b63f084 https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/templates/decode_attention_run.cu.jinja /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/templates/decode_attention_run.cu.jinja
