ADD --checksum=sha256:ca93d0d2af2165b36e188f76298862950e48659e7182132ca94f58388546bce9 https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/fmha_common.hpp /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/fmha_common.hpp
ADD --checksum=sha256:e1e44a496a6afa9f0c2604a2b9686c4df22d2836ea718e9db51b2b59c69e5ed2 https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/mxfp8_output.cuh /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/mxfp8_output.cuh
ADD --checksum=sha256:1aade06a2b38f531c2617cd008e8c6b0dd534038da3a83c6aa449cf6fcfa216a https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/sm100_fmha_q8kv4_traits.hpp /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/include/sm100/common/sm100_fmha_q8kv4_traits.hpp
