ADD --checksum=sha256:13ca91af97e8cce656ba9a17185f7193e3580f723c51079a1b74e5029608a630 https://raw.githubusercontent.com/vllm-project/MSA/${MSA_COMMIT}/python/fmha_sm100/decode_q8kv4/csrc/api/decode_attention_api.hpp /vllm/third_party/fmha_sm100/decode_q8kv4/csrc/api/decode_attention_api.hpp
