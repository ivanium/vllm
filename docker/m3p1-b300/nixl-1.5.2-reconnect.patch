diff --git a/test/unit/plugins/libfabric/libfabric_backend_test.cpp b/test/unit/plugins/libfabric/libfabric_backend_test.cpp
new file mode 100644
index 0000000..c5b0aa9
--- /dev/null
+++ b/test/unit/plugins/libfabric/libfabric_backend_test.cpp
@@ -0,0 +1,138 @@
+/*
+ * SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
